---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getPosts, formatDate, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first, so the next (older) one is i + 1
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const { Content } = await render(post);
---

<Layout
  title={`${title} — Iván Ajenjo`}
  description={description}
  lang="es"
  kind="article"
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
  <article class="on-light bg-surface text-fg min-h-screen pt-32 md:pt-40 pb-24 md:pb-32 px-6">
    <div class="max-w-[720px] mx-auto">
      <a href="/blog/" class="link-apple text-base">← Todos los artículos</a>

      <header class="mt-8">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-[1.1]">{title}</h1>
        <p class="text-fg-muted text-lg md:text-xl mt-5 leading-snug">{description}</p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-fg-subtle mt-6">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Actualizado el <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)}</span>
          {draft && (
            <span class="rounded-full bg-amber-400/20 text-amber-700 px-2 py-0.5 text-xs font-medium">Borrador</span>
          )}
        </div>
        {tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-5" aria-label="Etiquetas">
            {tags.map((tag) => <li class="chip">{tag}</li>)}
          </ul>
        )}
      </header>

      <hr class="border-0 border-t border-hairline my-10 md:my-12" />

      <div class="post-body">
        <Content />
      </div>

      {(newer || older) && (
        <nav class="grid sm:grid-cols-2 gap-4 mt-20" aria-label="Más artículos">
          {older ? (
            <a href={`/blog/${older.id}/`} class="card-light block p-6 hover:-translate-y-0.5">
              <span class="text-sm text-fg-subtle">← Anterior</span>
              <span class="block font-semibold tracking-tight mt-1">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer && (
            <a href={`/blog/${newer.id}/`} class="card-light block p-6 text-right hover:-translate-y-0.5">
              <span class="text-sm text-fg-subtle">Siguiente →</span>
              <span class="block font-semibold tracking-tight mt-1">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</Layout>
