---
import Layout from "../../layouts/Layout.astro";
import { getPosts, formatShortDate, readingTime, type Post } from "../../lib/posts";

const posts = await getPosts();

// Posts come newest first, so years end up in descending order too
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Layout
  title="Blog — Iván Ajenjo"
  description="Ideas sobre desarrollo backend, arquitectura de software y lo que voy aprendiendo por el camino."
  lang="es"
  kind="blog"
>
  <div class="min-h-screen pt-32 md:pt-40 pb-24 md:pb-32 px-6">
    <div class="max-w-[720px] mx-auto">
      <header>
        <p class="blog-kicker">Cuaderno</p>
        <h1 class="blog-title mt-4">Ideas de desarrollo<span class="text-accent">.</span></h1>
        <p class="blog-lede mt-6">
          Notas sobre backend, arquitectura y lo que voy aprendiendo por el camino.
          <a href="/rss.xml" class="blog-link whitespace-nowrap">RSS ↗</a>
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="text-fg-subtle mt-16">Todavía no hay artículos publicados. Pronto.</p>
      ) : (
        [...byYear].map(([year, yearPosts]) => (
          <section class="mt-16 md:mt-20" aria-labelledby={`y${year}`}>
            <h2 id={`y${year}`} class="blog-year">{year}</h2>
            <ol class="blog-index">
              {yearPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`} class="blog-entry">
                    <time class="blog-entry-date" datetime={post.data.pubDate.toISOString()}>
                      {formatShortDate(post.data.pubDate)}
                    </time>
                    <div>
                      <h3 class="blog-entry-title">
                        {post.data.title}
                        {post.data.draft && <span class="blog-draft">Borrador</span>}
                      </h3>
                      <p class="blog-entry-desc">{post.data.description}</p>
                      <p class="blog-meta mt-3">
                        {readingTime(post.body)}
                        {post.data.tags.map((tag) => <span class="ml-3">#{tag}</span>)}
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      )}
    </div>
  </div>
</Layout>
