---
const skills = [
  'Java', 'Spring Boot', 'Apache Kafka',
  'Google Cloud (GCP)', 'Kubernetes', 'Docker',
  'RESTful APIs', 'Microservices', 'CI/CD', 'PostgreSQL',
];

const stats = [
  { value: '4+', label: 'Years at Mercadona' },
  { value: '5+', label: 'Years in industry' },
  { value: 'GCP', label: 'Cloud-native focus' },
];
---

<section id="about" class="on-light bg-paper text-ink py-24 md:py-36 px-6">
  <div class="max-w-[1024px] mx-auto">
    <div class="max-w-3xl">
      <p class="reveal eyebrow mb-3">About me</p>
      <h2 class="reveal headline">
        I engineer backend systems designed to scale.
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="grid md:grid-cols-3 gap-5 mt-14 md:mt-20">
      <div class="reveal card-light p-8 md:p-10 md:col-span-2">
        <p class="text-xl md:text-2xl font-semibold tracking-tight leading-snug">
          With <span class="text-blue-apple">4+ years at Mercadona</span>, I've architected
          distributed microservices, driven event-streaming solutions with Kafka,
          and orchestrated cloud-native infrastructure on GCP.
        </p>
        <p class="text-muted text-lg leading-relaxed mt-6">
          I thrive at the intersection of software quality and system design —
          optimizing service performance, streamlining CI/CD pipelines,
          and designing resilient APIs that power large-scale operations.
        </p>
      </div>

      <div class="reveal card-dark p-8 md:p-10 flex flex-col justify-between text-white" style="transition-delay:.08s">
        <div class="text-6xl" aria-hidden="true">👨‍💻</div>
        <p class="text-[#a1a1a6] text-lg leading-snug mt-10">
          Currently focused on cloud-native architectures and distributed systems.
        </p>
      </div>

      {stats.map((s, i) => (
        <div class="reveal card-light p-8 md:p-10" style={`transition-delay:${0.08 * i}s`}>
          <p class="text-5xl md:text-6xl font-semibold tracking-tighter">{s.value}</p>
          <p class="text-muted text-base mt-2">{s.label}</p>
        </div>
      ))}

      <div class="reveal card-light p-8 md:p-10 md:col-span-3">
        <h3 class="text-xl font-semibold tracking-tight mb-5">Tech stack</h3>
        <div class="flex flex-wrap gap-2">
          {skills.map(skill => <span class="chip !bg-paper !shadow-none !text-base !px-4 !py-2">{skill}</span>)}
        </div>
      </div>
    </div>

    <div class="reveal flex items-center gap-8 mt-10">
      <a href="https://www.linkedin.com/in/iv%C3%A1n-i%C3%B1aki-ajenjo-vicente-2136031b7/" target="_blank" rel="noopener noreferrer" class="link-apple">LinkedIn &rsaquo;</a>
      <a href="https://github.com/ivanajenjo" target="_blank" rel="noopener noreferrer" class="link-apple">GitHub &rsaquo;</a>
    </div>
  </div>
</section>
