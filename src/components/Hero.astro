---
const stack = ['Java', 'Spring Boot', 'Kafka', 'Kubernetes', 'GCP'];
---

<section id="top" class="relative min-h-svh flex items-center justify-center overflow-hidden bg-black text-center px-6 pt-20 pb-24">
  <!-- Aurora + grid backdrop -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="aurora w-[90vw] h-[90vw] md:w-[55vw] md:h-[55vw] max-w-[720px] max-h-[720px] left-[8%] top-[6%] bg-[#0071e3]"></div>
    <div class="aurora w-[75vw] h-[75vw] md:w-[45vw] md:h-[45vw] max-w-[600px] max-h-[600px] right-[6%] top-[22%] bg-[#7c3aed] [animation-delay:-6s] !opacity-25"></div>
    <div class="absolute inset-0 grid-bg"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-black"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto">
    <p class="reveal eyebrow !text-[#2997ff] mb-4 font-mono !text-base">
      &lt;Backend Software Engineer /&gt;
    </p>
    <h1 class="reveal headline !text-[clamp(3rem,10vw,7rem)] !leading-[1] bg-gradient-to-b from-white via-white to-[#86868b] bg-clip-text text-transparent pb-2" style="transition-delay:.08s">
      Iván Ajenjo.
    </h1>
    <p class="reveal text-[#a1a1a6] text-xl md:text-3xl font-semibold tracking-tight max-w-2xl mx-auto mt-6 leading-snug" style="transition-delay:.16s">
      Scalable, cloud-native systems.
      <span class="block text-[#f5f5f7]">Built to stay up.</span>
    </p>

    <div class="reveal flex flex-col sm:flex-row gap-5 justify-center items-center mt-10" style="transition-delay:.24s">
      <a href="#experience" class="btn-primary">See my work</a>
      <a href="#contact" class="link-apple">Get in touch &rsaquo;</a>
    </div>

    <div class="reveal flex flex-wrap gap-2 justify-center mt-14" style="transition-delay:.32s">
      {stack.map(tag => <span class="chip border border-white/10 backdrop-blur">{tag}</span>)}
    </div>
  </div>

  <a href="#about" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[#86868b] hover:text-white transition-colors" aria-label="Scroll to About">
    <svg class="nudge" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>
