---
const stack = ['Java', 'Spring Boot', 'Kafka', 'Kubernetes', 'GCP'];
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black text-center px-6 pt-11">
  <!-- Soft spotlight -->
  <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(60% 50% at 50% 38%, rgba(41,151,255,0.18), transparent 70%);"></div>

  <div class="relative z-10 max-w-4xl mx-auto">
    <p class="reveal eyebrow !text-[#2997ff] mb-4">Backend Software Engineer</p>
    <h1 class="reveal headline !text-[clamp(3rem,10vw,7rem)] !leading-[1] bg-gradient-to-b from-white to-[#a1a1a6] bg-clip-text text-transparent pb-2" style="transition-delay:.08s">
      Iván Ajenjo.
    </h1>
    <p class="reveal text-[#a1a1a6] text-xl md:text-3xl font-semibold tracking-tight max-w-2xl mx-auto mt-6 leading-snug" style="transition-delay:.16s">
      Scalable, cloud-native systems.<br class="hidden sm:block" />
      <span class="text-[#f5f5f7]">Built to stay up.</span>
    </p>

    <div class="reveal flex flex-col sm:flex-row gap-5 justify-center items-center mt-10" style="transition-delay:.24s">
      <a href="#experience" class="btn-primary">See my work</a>
      <a href="#contact" class="link-apple">Get in touch &rsaquo;</a>
    </div>

    <div class="reveal flex flex-wrap gap-2 justify-center mt-14" style="transition-delay:.32s">
      {stack.map(tag => <span class="chip">{tag}</span>)}
    </div>
  </div>
</section>
