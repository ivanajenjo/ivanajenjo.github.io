---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-black/70 backdrop-blur-xl backdrop-saturate-150">
  <nav class="max-w-[1024px] mx-auto px-6 h-11 flex items-center justify-between text-xs">
    <a href="#" class="text-[#f5f5f7] font-semibold tracking-tight text-sm" aria-label="Home">Iván Ajenjo</a>
    <ul class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <li>
          <a href={link.href} class="text-[#d2d2d7] hover:text-white transition-colors duration-200">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <button id="menu-toggle" class="md:hidden text-[#d2d2d7] hover:text-white" aria-label="Open menu" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="3" y1="15" x2="21" y2="15"/>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden bg-black/90 backdrop-blur-xl">
    <ul class="flex flex-col px-6 pb-6 pt-2 gap-1">
      {links.map(link => (
        <li class="border-b border-white/10 last:border-0">
          <a href={link.href} class="mobile-link block py-3 text-2xl font-semibold tracking-tight text-[#f5f5f7]">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  document.querySelectorAll('.mobile-link').forEach(link =>
    link.addEventListener('click', () => setOpen(false)),
  );
</script>
