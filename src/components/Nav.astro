---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<div class="scroll-progress fixed top-0 inset-x-0 z-[55] h-[2px] bg-gradient-to-r from-[#0071e3] via-[#2997ff] to-[#a78bfa]" aria-hidden="true"></div>

<header class="fixed top-3 inset-x-3 z-50">
  <nav class="max-w-[1024px] mx-auto pl-5 pr-2 h-12 flex items-center justify-between text-xs rounded-full bg-black/60 backdrop-blur-xl backdrop-saturate-150 border border-white/10 shadow-[0_8px_32px_-12px_rgba(0,0,0,0.6)]">
    <a href="#" class="text-[#f5f5f7] font-semibold tracking-tight text-sm" aria-label="Home">
      Iván Ajenjo<span class="text-[#2997ff]">.</span>
    </a>
    <div class="flex items-center gap-1">
      <ul class="hidden md:flex items-center gap-1">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              class="nav-link block px-3.5 py-1.5 rounded-full text-[#d2d2d7] hover:text-white transition-colors duration-200 aria-[current=true]:text-white aria-[current=true]:bg-white/10"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="theme-toggle"
        class="h-9 w-9 grid place-items-center rounded-full text-[#d2d2d7] hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle color theme"
      >
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="theme-icon-moon hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>
      <button
        id="menu-toggle"
        class="md:hidden h-9 w-9 grid place-items-center rounded-full text-[#d2d2d7] hover:text-white hover:bg-white/10"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line class="origin-center transition-transform duration-300" x1="3" y1="9" x2="21" y2="9"/>
          <line class="origin-center transition-transform duration-300" x1="3" y1="15" x2="21" y2="15"/>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden mt-2 rounded-3xl bg-black/85 backdrop-blur-xl border border-white/10 overflow-hidden transition-all duration-300 opacity-0 -translate-y-2 pointer-events-none invisible"
  >
    <ul class="flex flex-col px-6 py-3">
      {links.map(link => (
        <li class="border-b border-white/10 last:border-0">
          <a href={link.href} class="mobile-link block py-3 text-2xl font-semibold tracking-tight text-[#f5f5f7]">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  #menu-toggle[aria-expanded="true"] line:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] line:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }
</style>

<script>
  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closedClasses = ['opacity-0', '-translate-y-2', 'pointer-events-none', 'invisible'];

  const setOpen = (open: boolean) => {
    closedClasses.forEach(c => menu?.classList.toggle(c, !open));
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('.mobile-link').forEach(link =>
    link.addEventListener('click', () => setOpen(false)),
  );
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Theme toggle: explicit choice is stored, otherwise follow the system
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ?? (media.matches ? 'dark' : 'light')) === 'dark';
  const syncIcon = () => {
    document.querySelector('.theme-icon-sun')?.classList.toggle('hidden', isDark());
    document.querySelector('.theme-icon-moon')?.classList.toggle('hidden', !isDark());
  };
  syncIcon();
  media.addEventListener('change', syncIcon);
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncIcon();
  });

  // Highlight the nav link of the section in view
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const spy = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        navLinks.forEach(a =>
          a.setAttribute('aria-current', String(a.hash === `#${entry.target.id}`)),
        );
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('section[id]').forEach(s => spy.observe(s));
</script>
