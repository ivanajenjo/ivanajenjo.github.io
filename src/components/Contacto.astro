---
const links = [
  {
    label: "GitHub",
    value: "github.com/ivanajenjo",
    href: "https://github.com/ivanajenjo",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>`,
  },
  {
    label: "LinkedIn",
    value: "Iván Iñaki Ajenjo",
    href: "https://www.linkedin.com/in/iv%C3%A1n-i%C3%B1aki-ajenjo-vicente-2136031b7/",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<section id="contact" class="bg-black text-[#f5f5f7] py-24 md:py-36 px-6">
  <div class="max-w-[1024px] mx-auto text-center">
    <p class="reveal eyebrow mb-3">Contact</p>
    <h2 class="reveal headline">Let's connect.</h2>
    <p class="reveal text-[#a1a1a6] text-xl md:text-2xl font-semibold tracking-tight max-w-xl mx-auto mt-6 leading-snug">
      Open to new opportunities, technical discussions, and interesting collaborations.
    </p>

    <div class="grid sm:grid-cols-2 gap-5 mt-14 text-left">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target={link.href.startsWith("mailto") ? undefined : "_blank"}
            rel="noopener noreferrer"
            style={`transition-delay:${0.08 * i}s`}
            class="reveal group card-dark p-8 md:p-10 flex flex-col gap-10 hover:bg-[#2a2a2d] transition-colors duration-300"
          >
            <span class="text-white [&_svg]:w-9 [&_svg]:h-9" set:html={link.icon} />
            <div>
              <p class="text-2xl font-semibold tracking-tight">{link.label}</p>
              <p class="text-[#a1a1a6] text-base mt-1 break-all">{link.value}</p>
              <p class="text-[#2997ff] mt-4 group-hover:underline">Open &rsaquo;</p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="reveal card-dark mt-5 px-8 py-16 md:py-20 relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(50% 70% at 50% 100%, rgba(41,151,255,0.18), transparent 70%);"></div>
      <div class="relative">
        <h3 class="text-3xl md:text-5xl font-semibold tracking-tight">Got an interesting challenge?</h3>
        <p class="text-[#a1a1a6] text-lg max-w-lg mx-auto mt-5 leading-snug">
          Whether it's a backend architecture problem, a cloud migration, or just a
          conversation about distributed systems — I'm in.
        </p>
        <a
          href="https://www.linkedin.com/in/iv%C3%A1n-i%C3%B1aki-ajenjo-vicente-2136031b7/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-9"
        >
          Send a message
        </a>
      </div>
    </div>
  </div>
</section>
