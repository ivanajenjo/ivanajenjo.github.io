---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Article {
  publishedTime: Date;
  modifiedTime?: Date;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  /** Page language; the portfolio is in English, the blog in Spanish */
  lang?: "en" | "es";
  /** "profile" for the home page, "blog" for the blog index, "article" for posts */
  kind?: "profile" | "blog" | "article";
  article?: Article;
}

const {
  title = "Iván Ajenjo — Backend Software Engineer | Java, Spring Boot & Kafka",
  description = "Iván Ajenjo is a Backend Software Engineer in Valencia, Spain, specialized in Java, Spring Boot microservices, Apache Kafka and cloud-native platforms on Kubernetes.",
  lang = "en",
  kind = "profile",
  article,
} = Astro.props;
const ogLocale = lang === "es" ? "es_ES" : "en_US";
// The blog has its own warm, editorial look (see the .blog scope in global.css)
const isBlog = kind === "blog" || kind === "article";

const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data so search engines can identify the person behind the site
const siteUrl = Astro.site?.origin ?? "https://ivan-ajenjo.com";
const ogImage = `${siteUrl}/og-image.png`;

const personSchema = {
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  name: "Iván Ajenjo",
  alternateName: ["Ivan Ajenjo", "Iván Ajenjo Vicente", "Ivan Ajenjo Vicente"],
  url: `${siteUrl}/`,
  image: ogImage,
  description,
  jobTitle: "Backend Software Engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Valencia",
    addressCountry: "ES",
  },
  knowsAbout: ["Java", "Spring Boot", "Microservices", "Apache Kafka", "Cloud Computing", "Kubernetes"],
  alumniOf: { "@type": "CollegeOrUniversity", name: "Universitat Politècnica de València" },
  sameAs: [
    "https://github.com/ivanajenjo",
    "https://www.linkedin.com/in/iv%C3%A1n-i%C3%B1aki-ajenjo-vicente-2136031b7/",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: "Iván Ajenjo",
  inLanguage: "en",
  publisher: { "@id": `${siteUrl}/#person` },
};

const pageSchemas = {
  profile: {
    "@type": "ProfilePage",
    "@id": `${canonical.href}#profile`,
    url: canonical.href,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: { "@id": `${siteUrl}/#website` },
    mainEntity: { "@id": `${siteUrl}/#person` },
  },
  blog: {
    "@type": "Blog",
    "@id": `${canonical.href}#blog`,
    url: canonical.href,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: { "@id": `${siteUrl}/#website` },
    author: { "@id": `${siteUrl}/#person` },
  },
  article: {
    "@type": "BlogPosting",
    "@id": `${canonical.href}#article`,
    url: canonical.href,
    headline: title,
    description,
    inLanguage: lang,
    image: ogImage,
    datePublished: article?.publishedTime.toISOString(),
    dateModified: (article?.modifiedTime ?? article?.publishedTime)?.toISOString(),
    keywords: article?.tags,
    isPartOf: { "@id": `${siteUrl}/blog/#blog` },
    author: { "@id": `${siteUrl}/#person` },
    mainEntityOfPage: canonical.href,
  },
};
const pageSchema = pageSchemas[kind];

const jsonLd = { "@context": "https://schema.org", "@graph": [personSchema, websiteSchema, pageSchema] };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Iván Ajenjo" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    {isBlog ? (
      <>
        <meta name="theme-color" content="#f4eee3" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#1a1612" media="(prefers-color-scheme: dark)" />
      </>
    ) : (
      <meta name="theme-color" content="#000000" />
    )}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Iván Ajenjo — Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content={kind === "article" ? "article" : kind === "blog" ? "website" : "profile"} />
    <meta property="og:site_name" content="Iván Ajenjo" />
    <meta property="og:locale" content={ogLocale} />
    {kind === "profile" && (
      <>
        <meta property="profile:first_name" content="Iván" />
        <meta property="profile:last_name" content="Ajenjo" />
      </>
    )}
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
        <meta property="article:author" content={`${siteUrl}/`} />
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Iván Ajenjo — Backend Software Engineer" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&family=Fira+Code:wght@400;500&display=swap"
    />
    {isBlog && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..650;1,8..60,400..650&display=swap"
      />
    )}

    <!-- Apply the saved theme before first paint to avoid a flash -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class={isBlog ? "blog" : undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="on-light bg-surface text-fg-subtle py-10 px-6 text-xs">
      <div class="max-w-[1024px] mx-auto flex flex-col sm:flex-row gap-4 items-center justify-between">
        <p>Copyright © {new Date().getFullYear()} Iván Ajenjo. Built with Astro & Tailwind.</p>
        <a href="#" class="hover:text-fg transition-colors">Back to top ↑</a>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Spotlight cards: expose the pointer position as CSS variables
      document.querySelectorAll<HTMLElement>(".spotlight").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>
